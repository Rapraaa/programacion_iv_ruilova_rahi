# ==========================================================
#  .gitignore - Programación IV (Desarrollo Móvil)
#  Cubre: Flutter/Dart, React, React Native, Expo, Ionic,
#         Android (Kotlin/Java), iOS (Swift/Xcode), Node.js
#  Las reglas aplican en cualquier subcarpeta (ej. proyectos/app1/)
# ==========================================================


# ---------------------------
# Seguridad: credenciales y llaves
# ---------------------------
.env
.env.*
!.env.example
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
key.properties
google-services.json
GoogleService-Info.plist
secrets.json


# ---------------------------
# Flutter / Dart
# ---------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.g.dart.bak
.fvm/flutter_sdk
**/doc/api/
.metadata.bak

# Flutter generado en plataformas
**/android/app/debug
**/android/app/profile
**/android/app/release
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/


# ---------------------------
# Node.js / React / React Native
# ---------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
.npm/
.eslintcache
*.tsbuildinfo

# Builds web (React, Vite, Next)
dist/
.next/
out/
.vite/

# React Native / Metro
.metro-health-check*
*.jsbundle
**/android/app/src/main/assets/index.android.bundle

# Expo
.expo/
.expo-shared/
web-build/
expo-env.d.ts


# ---------------------------
# Ionic / Capacitor / Cordova
# ---------------------------
www/
.angular/
platforms/
plugins/
.sourcemaps/


# ---------------------------
# Android (Kotlin / Java)
# ---------------------------
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
output.json
**/android/app/.cxx/


# ---------------------------
# iOS / Xcode / CocoaPods
# ---------------------------
Pods/
DerivedData/
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.bundle/
vendor/bundle/


# ---------------------------
# Editores e IDEs
# ---------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~


# ---------------------------
# Sistema operativo
# ---------------------------
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
.Trash-*
